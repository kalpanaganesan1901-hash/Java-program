import java.util.*;

public class Main {
    public static void main(String[] args) {
      Scanner s = new Scanner(System.in);
      int a =s.nextInt();
      int b =s.nextInt();
      for(int i=a+1;i<b;i++){
        boolean prime = true;
        if(i<=1) 
        continue;
      for (int j=2;j<=i/2;j++){
        if(i%j==0){
          prime = false;
          break;
        }
      }
        if(prime){
        System.out.println(i);  
        }
      }
  }
}
