import java.util.*;

public class Main {
    public static void main(String[] args) {
      Scanner s = new Scanner(System.in);
      int n = s.nextInt();
      int count = 0;
      while(n>0){
        int digit = n%10;
        if (digit==0){
          count++;
        }
        n/=10;
      }
      System.out.println(count);
  }
}
